# Leave these empty to run Endpaper device-only (no accounts, no sync).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: sends the "your account is deleted" email (R-AUTH-6).
RESEND_API_KEY=
EMAIL_FROM=
# Public URL, used for link previews (Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
